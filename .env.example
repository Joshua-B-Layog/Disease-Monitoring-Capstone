# Server
PORT=5000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cabuyao_cdms_db

# Brevo Transactional Email API (used for OTP, password recovery, approvals, weekly summaries)
# The sender address must be verified in the Brevo dashboard (Account -> Senders).
BREVO_FROM=your_verified_sender@example.com
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# JWT signing secret for authenticated sessions (generate a long random string)
# MUST be set in the Railway dashboard too.
JWT_SECRET=change_me_to_a_long_random_string

# Optional
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=http://localhost:5000